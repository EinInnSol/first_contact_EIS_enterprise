# First Contact E.I.S. - Development Environment
# Copy this to .env and customize

# Environment
ENVIRONMENT=development

# Database - Cloud SQL PostgreSQL via proxy
DATABASE_URL=postgresql+asyncpg://firstcontact_app:FCeis2025!Secure@127.0.0.1:5432/firstcontact

# JWT Authentication - CHANGE IN PRODUCTION!
JWT_SECRET=dev-secret-key-change-in-production-12345
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# GCP (for production)
GCP_PROJECT_ID=einharjer-valhalla
GCP_REGION=us-east5

# API
DEBUG=true

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Encryption - CHANGE IN PRODUCTION!
ENCRYPTION_KEY=dev-encryption-key-change-me
