# First Contact E.I.S. - Backend Environment Variables
# Copy this to .env for local development

# Environment
ENVIRONMENT=development
PILOT_MODE=True
DEBUG=True

# Database (Local Development)
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/firstcontact
DB_HOST=localhost
DB_PORT=5432
DB_NAME=firstcontact
DB_USER=postgres
DB_PASSWORD=

# JWT Secret (CHANGE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Anthropic API (for AI features)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# GCP Configuration (Production Only)
GCP_PROJECT_ID=einharjer-valhalla
GCP_REGION=us-east5

# Feature Flags
ENABLE_AI_CASE_PLANS=True
ENABLE_AI_ADVISOR=True
ENABLE_ORCHESTRATOR=True

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# API Configuration
API_V1_PREFIX=/api/v1
