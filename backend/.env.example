# Environment Configuration
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/firstcontact
DATABASE_SYNC_URL=postgresql://postgres:password@localhost:5432/firstcontact

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# GCP Project
GCP_PROJECT_ID=einharjer-valhalla
GCP_REGION=us-east5

# API Settings
API_V1_PREFIX=/api/v1
DEBUG=true

# Encryption (for SSN)
ENCRYPTION_KEY=your-fernet-key-here-generate-with-cryptography
