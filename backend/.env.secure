# ================================================================
# FIRST CONTACT E.I.S. - SECURE ENVIRONMENT CONFIGURATION
# ================================================================
# DO NOT COMMIT THIS FILE TO GIT
# All secrets should be stored in GCP Secret Manager for production
# ================================================================

# -------------------- APPLICATION --------------------
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# -------------------- DATABASE --------------------
# Local development uses Cloud SQL Proxy
DATABASE_URL=postgresql+asyncpg://firstcontact_app:${DB_PASSWORD}@127.0.0.1:5432/firstcontact
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# -------------------- GCP --------------------
GCP_PROJECT_ID=einharjer-valhalla
GCP_REGION=us-east5
CLOUD_SQL_INSTANCE=einharjer-valhalla:us-central1:firstcontact-eis-db

# -------------------- SECURITY --------------------
# Generate new JWT secret: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_NEW_SECRET_FROM_GCP_SECRET_MANAGER
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Generate encryption key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_NEW_ENCRYPTION_KEY

# -------------------- ANTHROPIC --------------------
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=REPLACE_WITH_NEW_KEY_FROM_GCP_SECRET_MANAGER
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# -------------------- CORS --------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# -------------------- RATE LIMITING --------------------
RATE_LIMIT_QR_INTAKE=5/hour
RATE_LIMIT_API=100/minute

# -------------------- FEATURE FLAGS --------------------
ENABLE_AI_RECOMMENDATIONS=true
ENABLE_LAYER8=true
ENABLE_AUDIT_LOGGING=true

# ================================================================
# PRODUCTION DEPLOYMENT NOTES:
# - All secrets above should come from GCP Secret Manager
# - Use Cloud Run environment variables to inject secrets
# - Never commit actual secret values to git
# ================================================================
