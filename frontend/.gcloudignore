# This file tells gcloud which files to ignore during frontend deployment

# Git
.git
.gitignore

# Dependencies (will be installed during Docker build)
node_modules/

# Build artifacts (will be rebuilt)
.next/
out/
build/

# Environment (use Cloud Run env vars instead)
.env
.env.local
.env.*.local

# Testing
coverage/
.nyc_output/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Documentation
*.md
docs/

# Misc
.DS_Store
Thumbs.db
