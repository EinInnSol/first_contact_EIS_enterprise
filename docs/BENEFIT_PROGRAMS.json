  },
  "calculation_rules": {
    "gr_with_housing_subsidy": {
      "description": "When GR Housing Subsidy is activated, GR cash amount reduces by $100",
      "formula": {
        "gr_base": 221,
        "gr_housing_subsidy": 575,
        "gr_reduction_when_subsidy_active": 100,
        "gr_with_subsidy": 121
      },
      "example": {
        "without_subsidy": {
          "gr": 221,
          "housing_help": 0,
          "total": 221
        },
        "with_subsidy": {
          "gr": 121,
          "gr_housing_subsidy": 575,
          "total_benefit": 696,
          "note": "Net gain is $475 ($696 - $221)"
        }
      }
    },
    "ssi_calfresh_interaction": {
      "description": "SSI recipients are now eligible for CalFresh in California (as of 2019)",
      "note": "Previously SSI excluded CalFresh. Now can receive both."
    },
    "ihss_household_income": {
      "description": "IHSS payments to a live-in family caregiver count as household income but not for the recipient's benefit calculations",
      "example": {
        "recipient_ssi": 1183,
        "spouse_ihss_income": 1200,
        "household_total": 2383
      }
    }
  },
  "application_sequencing": {
    "recommended_order": [
      {
        "step": 1,
        "programs": ["calfresh", "medi_cal", "gr"],
        "reason": "Can apply simultaneously at DPSS. Fastest benefits.",
        "timeline": "Week 1"
      },
      {
        "step": 2,
        "programs": ["lifeline", "care"],
        "reason": "Quick wins while waiting for other benefits.",
        "timeline": "Week 1-2"
      },
      {
        "step": 3,
        "programs": ["ssi"],
        "reason": "Start application early - takes 3-6 months.",
        "timeline": "Week 2"
      },
      {
        "step": 4,
        "programs": ["gr_housing_subsidy"],
        "reason": "Once housing is secured and GR is active.",
        "timeline": "When housed"
      },
      {
        "step": 5,
        "programs": ["ihss"],
        "reason": "After SSI is approved.",
        "timeline": "After SSI approval"
      }
    ]
  }
}
