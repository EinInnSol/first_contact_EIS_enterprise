{
  "programs": {
    "income": [
      {
        "code": "ssi",
        "name": "Supplemental Security Income",
        "category": "income",
        "typical_amount": 1183,
        "description": "Federal disability income for individuals with limited income and resources",
        "eligibility": {
          "requires": ["disability_documentation", "low_income", "limited_resources"],
          "excludes": [],
          "age": "any"
        },
        "timeline": "3-6 months (with SOAR assistance can be faster)",
        "dependencies": {
          "enables": ["ihss", "medi_cal_automatic"]
        },
        "notes": "Apply through SSA. SOAR program helps homeless individuals navigate process."
      },
      {
        "code": "ssdi",
        "name": "Social Security Disability Insurance",
        "category": "income",
        "typical_amount": 1500,
        "description": "Disability insurance based on work history",
        "eligibility": {
          "requires": ["disability_documentation", "sufficient_work_credits"],
          "excludes": [],
          "work_credits_needed": true
        },
        "timeline": "3-6 months",
        "dependencies": {
          "enables": ["medicare_after_24_months"]
        },
        "notes": "Amount varies based on work history. Can receive both SSDI and SSI in some cases."
      },
      {
        "code": "gr",
        "name": "General Relief",
        "category": "income",
        "typical_amount": 221,
        "description": "County cash assistance for single adults without dependents",
        "eligibility": {
          "requires": ["no_dependents", "low_income", "not_receiving_ssi_ssdi"],
          "excludes": ["ssi", "ssdi", "calworks"],
          "residency": "county"
        },
        "timeline": "2-4 weeks",
        "dependencies": {
          "enables": ["gr_housing_subsidy"],
          "modified_by": {
            "gr_housing_subsidy": {
              "effect": "reduces_amount",
              "reduction": 100,
              "new_amount": 121
            }
          }
        },
        "notes": "Apply through DPSS. Expedited for homeless individuals."
      },
      {
        "code": "calworks",
        "name": "CalWORKs",
        "category": "income",
        "typical_amount": 750,
        "description": "Cash aid for families with children",
        "eligibility": {
          "requires": ["has_dependent_children", "low_income"],
          "excludes": ["gr"],
          "family_type": "families_with_children"
        },
        "timeline": "2-4 weeks",
        "dependencies": {
          "enables": ["calworks_housing_support"]
        },
        "notes": "Amount varies by family size. Includes work requirements and support services."
      },
      {
        "code": "veterans_pension",
        "name": "Veterans Pension",
        "category": "income",
        "typical_amount": 1200,
        "description": "Monthly benefit for wartime veterans with limited income",
        "eligibility": {
          "requires": ["veteran_status", "wartime_service", "low_income"],
          "excludes": [],
          "age": "65+ or disabled"
        },
        "timeline": "2-4 months",
        "dependencies": {},
        "notes": "Apply through VA. Can be combined with other benefits."
      }
    ],
    "housing": [
      {
        "code": "gr_housing_subsidy",
        "name": "GR Housing Subsidy",
        "category": "housing",
        "typical_amount": 575,
        "description": "Rental assistance for General Relief recipients",
        "eligibility": {
          "requires": ["gr_recipient", "housed_or_housing_found"],
          "excludes": []
        },
        "timeline": "1-2 weeks once housed",
        "dependencies": {
          "affects": {
            "gr": {
              "effect": "reduces_amount",
              "reduction": 100
            }
          }
        },
        "notes": "CRITICAL: Reduces GR by $100, so net housing benefit is $575 but total GR becomes $121 instead of $221."
      },
      {
        "code": "section8",
        "name": "Section 8 Housing Choice Voucher",
        "category": "housing",
        "typical_amount": 1200,
        "description": "Federal rental assistance covering most of rent",
        "eligibility": {
          "requires": ["low_income", "on_waitlist"],
          "excludes": []
        },
        "timeline": "Waitlist is 3-7 years in most areas",
        "dependencies": {},
        "notes": "Extremely long waitlist. Check if waitlist is even open."
      },
      {
        "code": "vash",
        "name": "HUD-VASH Voucher",
        "category": "housing",
        "typical_amount": 1200,
        "description": "VA rental assistance for homeless veterans",
        "eligibility": {
          "requires": ["veteran_status", "homeless_status", "va_healthcare_eligible"],
          "excludes": []
        },
        "timeline": "1-3 months",
        "dependencies": {},
        "notes": "Much faster than regular Section 8. Includes case management support."
      },
      {
        "code": "rrh",
        "name": "Rapid Rehousing",
        "category": "housing",
        "typical_amount": 800,
        "description": "Time-limited rental assistance",
        "eligibility": {
          "requires": ["homeless_status", "income_potential"],
          "excludes": [],
          "vi_spdat_range": "4-8"
        },
        "timeline": "2-8 weeks",
        "duration": "6-24 months",
        "dependencies": {},
        "notes": "Best for individuals who can increase income during subsidy period."
      },
      {
        "code": "psh",
        "name": "Permanent Supportive Housing",
        "category": "housing",
        "typical_amount": 1400,
        "description": "Long-term housing with ongoing support services",
        "eligibility": {
          "requires": ["chronic_homeless_status", "disability_documentation"],
          "excludes": [],
          "vi_spdat_range": "8+"
        },
        "timeline": "3-12 months",
        "dependencies": {},
        "notes": "Requires documented disability. Best for highest-acuity individuals."
      },
      {
        "code": "shallow_subsidy",
