      },
      {
        "code": "calworks_housing",
        "name": "CalWORKs Housing Support Program",
        "category": "housing",
        "typical_amount": 1000,
        "description": "Housing assistance for CalWORKs families",
        "eligibility": {
          "requires": ["calworks_recipient", "homeless_or_at_risk"],
          "excludes": []
